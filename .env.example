# --- Kraken API Credentials ---
# Generate keys at https://pro.kraken.com/ (requires Trade permissions)
ZEPHYR_API_KEY=your_api_key_here
ZEPHYR_API_SECRET=your_api_secret_here

# --- Mode & Symbols ---
# Set to True to enable REAL live trading.
# If False, the bot runs in safe TEST MODE (paper trading).
ZEPHYR_LIVE=False
ZEPHYR_SYMBOLS=PEPE/USD
ZEPHYR_TEST_BALANCE=500.0

# --- Strategy Parameters ---
ZEPHYR_TRADE_AMOUNT=10.0
ZEPHYR_BASE_SPREAD=0.4
ZEPHYR_RISK_AVERSION=0.05
ZEPHYR_REFRESH_TOLERANCE=0.05
ZEPHYR_MAKER_FEE=0.16
ZEPHYR_LOG_LEVEL=INFO
ZEPHYR_IGNORE_FEES=False
